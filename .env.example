# =========================================
# Research Agent Configuration
# =========================================
# Copy this file to .env and fill in your API keys

# -----------------------------------------
# Application Settings
# -----------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------
# API Settings (FastAPI Backend)
# -----------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------
# Web UI Settings (Next.js Frontend)
# -----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------
# Database
# -----------------------------------------
# SQLite path is relative to project root.
# The `data/` folder is created automatically.
DATABASE_URL=sqlite:///data/research_agent.db

# -----------------------------------------
# LLM Provider Selection
# -----------------------------------------
# This sets the DEFAULT provider used by agents.
# Individual agents can be overridden in the UI.
# Options: openrouter, openai, anthropic, gemini, groq, cerebras, sambanova, mistral, ollama
LLM_PROVIDER=openrouter

# =========================================
# API Keys
# =========================================
# Only fill in keys for providers you intend to use.

# --- OpenRouter (Recommended: aggregates many models) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic (Claude) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Gemini ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Groq ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Cerebras ---
# https://cloud.cerebras.ai/platform
CEREBRAS_API_KEY=

# --- SambaNova ---
# https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# --- Mistral AI ---
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# --- xAI (Grok) ---
# https://console.x.ai/
XAI_API_KEY=

# =========================================
# Local LLM Configuration
# =========================================

# --- Ollama ---
# URL to your local Ollama instance. No API key needed.
OLLAMA_BASE_URL=http://localhost:11434
