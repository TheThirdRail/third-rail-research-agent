# OpenRouter API Key (free tier available at https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Ollama for local fallback (only if you want offline capability)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Premium LLM providers (only if you want to upgrade)
# ANTHROPIC_API_KEY=your_anthropic_key
# OPENAI_API_KEY=your_openai_key

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///data/performance.db

# API Settings (for web UI backend)
API_HOST=0.0.0.0
API_PORT=8000

# Web UI Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
