# =========================================
# Research Agent Configuration
# =========================================
# Copy this file to .env and fill in your API keys

# -----------------------------------------
# Application Settings
# -----------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Force UTF-8 stdout/stderr encoding (avoids Windows Unicode errors)
PYTHONIOENCODING=utf-8

# -----------------------------------------
# API Settings (FastAPI Backend)
# -----------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret protecting admin/mutation API routes (agent config,
# budget changes, channel upload).  Leave empty to disable admin routes
# entirely (they will return 503).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Server-side secret used by the Next.js frontend to sign admin session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SESSION_SECRET=
# Comma-separated allowed CORS origins.  Defaults to localhost:3000 when
# empty.  Wildcard '*' is rejected because the API sends credentials.
CORS_ORIGINS=

# -----------------------------------------
# Web UI Settings (Next.js Frontend)
# -----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side URL used by Next.js route handlers.  Docker Compose sets this to
# http://backend:8000; local Next dev falls back to NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=

# -----------------------------------------
# Database
# -----------------------------------------
# SQLite path is relative to project root.
# The `data/` folder is created automatically.
DATABASE_URL=sqlite:///data/research_agent.db

# -----------------------------------------
# LLM Provider Selection
# -----------------------------------------
# This sets the DEFAULT provider used by agents.
# Individual agents can be overridden in the UI.
# Options: openrouter, openai, anthropic, gemini, groq, cerebras, sambanova, mistral, lmstudio, ollama
LLM_PROVIDER=openrouter

# =========================================
# API Keys
# =========================================
# Only fill in keys for providers you intend to use.

# --- OpenRouter (Recommended: aggregates many models) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL for local bridges.
OPENAI_BASE_URL=

# --- Anthropic (Claude) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Gemini ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is a legacy alias.
GOOGLE_API_KEY=

# --- Groq ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Cerebras ---
# https://cloud.cerebras.ai/platform
CEREBRAS_API_KEY=

# --- SambaNova ---
# https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# --- Mistral AI ---
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# --- xAI (Grok) ---
# https://console.x.ai/
XAI_API_KEY=

# =========================================
# Local LLM Configuration
# =========================================

# --- Ollama ---
# URL to your local Ollama instance. No API key needed.
OLLAMA_BASE_URL=http://localhost:11434

# --- LM Studio (Local OpenAI-compatible server) ---
# Start LM Studio local server and set the API base URL.
# If running backend in Docker, host URL is usually http://host.docker.internal:1234/v1
LM_STUDIO_API_BASE=http://localhost:1234/v1
# Keep non-empty for LiteLLM/OpenAI-compatible clients.
LM_STUDIO_API_KEY=lm-studio
# Enable automatic fallback to LM Studio for transient provider failures
LM_STUDIO_FALLBACK_ENABLED=true
# Loaded model ID in LM Studio to use for fallback requests
LM_STUDIO_FALLBACK_MODEL=qwen2.5-7b-instruct

# =========================================
# Optional Codex OAuth Testing
# =========================================
# Disabled by default. This is local-only and intended for personal testing with
# an external Codex/OAuth workflow. Do not paste cookies, browser session tokens,
# bearer tokens, or refresh tokens into this project.
CODEX_OAUTH_TESTING_ENABLED=false
CODEX_OAUTH_MODE=disabled
CODEX_CLI_COMMAND=codex
CODEX_REQUIRE_LOCALHOST=true
CODEX_ALLOW_PUBLIC_API=false
CODEX_MAX_PROMPT_CHARS=30000
CODEX_TIMEOUT_SECONDS=300

# Local token usage logs for the OAuth bridge. These logs are private local
# telemetry and may include user-visible query text and provided links.
TOKEN_USAGE_LOG_ENABLED=true
TOKEN_USAGE_LOG_DIR=token-usage
TOKEN_USAGE_LOG_FILE=token-usage.jsonl
TOKEN_USAGE_TIMEZONE=America/New_York
TOKEN_USAGE_INCLUDE_QUERY_TEXT=true

# Bridge mode example:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://host.docker.internal:8787/v1
# OPENAI_API_KEY=local-placeholder
# SELECTED_MODEL=gpt-5.3-codex
# CODEX_OAUTH_TESTING_ENABLED=true
# CODEX_OAUTH_MODE=openai_compatible_bridge
# CODEX_REQUIRE_LOCALHOST=true
# CODEX_ALLOW_PUBLIC_API=false

# CLI mode example:
# CODEX_OAUTH_TESTING_ENABLED=true
# CODEX_OAUTH_MODE=codex_cli

# =========================================
# Web Search (SearxNG)
# =========================================
# Base URL to your SearxNG instance (e.g., http://localhost:8080)
SEARXNG_BASE_URL=
# Optional API key if your instance is protected
SEARXNG_API_KEY=

# =========================================
# Source Gathering Policy
# =========================================
CANDIDATE_PROBE_LIMIT=15
RETAINED_SOURCE_MIN=3
RETAINED_SOURCE_MAX=5
SEARCH_TIME_WINDOW_DAYS=7
STRICT_BUCKET_ENFORCEMENT=true
REQUIRED_BUCKET_GROUPS=left_side,right_side
EXACT_CENTER_PREFERRED=true
MAX_PER_EXACT_BIAS=1
MAX_PER_BUCKET_GROUP=2
ALLOW_SAME_BIAS_BACKFILL=false
ANALYSIS_RSS_FIRST_ENABLED=true
ANALYSIS_RSS_TIMEOUT_SECONDS=6
ANALYSIS_RSS_MAX_FEEDS_PER_BUCKET=3
RSS_CANDIDATE_MIN_STORY_SCORE=0.45

# =========================================
# Semantic Search
# =========================================
# Phase 1 semantic query expansion uses a lightweight chat-completion call to
# add ideologically varied search phrases to StoryPacket.query_pack. It is
# disabled by default and fails open to deterministic queries on errors.
#
# To test query expansion with the local Codex bridge:
# 1. Start the bridge: research-agent codex-oauth bridge --host 127.0.0.1 --port 8787
# 2. Set LLM_PROVIDER=openai, SELECTED_MODEL=gpt-5.3-codex, and the bridge
#    CODEX/OPENAI values in the Optional Codex OAuth Testing section above.
# 3. Set SEMANTIC_QUERY_EXPANSION_ENABLED=true.
SEMANTIC_QUERY_EXPANSION_ENABLED=false
SEMANTIC_QUERY_EXPANSION_MAX_QUERIES=4
SEMANTIC_QUERY_EXPANSION_AGENT_NAME=semantic_query_expander

# Semantic memory is disabled by default.
# Default local/dev mode uses deterministic fake embeddings with no network dependency.
# For local manual testing with LM Studio:
# 1. Load an embeddings model in LM Studio.
# 2. Set SEMANTIC_MEMORY_ENABLED=true or SEMANTIC_CANDIDATE_SCORING_ENABLED=true.
# 3. Replace EMBEDDING_PROVIDER/EMBEDDING_MODEL with the LM Studio values below.
SEMANTIC_MEMORY_ENABLED=false
SEMANTIC_CANDIDATE_SCORING_ENABLED=false
SEMANTIC_FAIL_OPEN=true
SEMANTIC_TOP_K=4
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-hash-v1
# EMBEDDING_PROVIDER=lmstudio
# EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
EMBEDDING_BATCH_SIZE=32
